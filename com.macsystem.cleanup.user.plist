<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.macsystem.cleanup.user.plist
  ─────────────────────────────────────────────────────────────────────────────
  LaunchAgent: runs mac_cleanup.sh as the current user daily at 3:00 AM.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.macsystem.cleanup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/vikrambala/bin/mac_cleanup.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/vikrambala/Library/Logs/mac_cleanup/launchd_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/vikrambala/Library/Logs/mac_cleanup/launchd_stderr.log</string>

    <key>RunAtLoad</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>KeepAlive</key>
    <false/>

    <key>LowPriorityIO</key>
    <true/>

    <key>Nice</key>
    <integer>10</integer>

    <key>WorkingDirectory</key>
    <string>/tmp</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
